[
    // Global
    {
        "bindings": {
            "alt-shift-w": "workspace::CloseWindow",
            "ctrl-f": "buffer_search::DeployReplace", // default ctrl-h, I use ctrl-h for tabs
            "ctrl-shift-l": "editor::SelectLine" // default ctrl-l, I use ctrl-l for tabs
        }
    },

    // Editor/Tab Navigation
    {
        "bindings": {
            "ctrl-h": "pane::ActivatePreviousItem",
            "ctrl-l": "pane::ActivateNextItem",
            "shift-alt-,": "pane::SwapItemLeft",
            "shift-alt-.": "pane::SwapItemRight"
        }
    },

    // Pane Navigation (vim-style)
    {
        // Move between panes
        "bindings": {
            "alt-h": "workspace::ActivatePaneLeft",
            "alt-l": "workspace::ActivatePaneRight",
            "alt-k": "workspace::ActivatePaneUp",
            "alt-j": "workspace::ActivatePaneDown"
        }
    },
    {
        // Move item to new pane
        "bindings": {
            "ctrl-alt-h": "pane::SplitAndMoveLeft",
            "ctrl-alt-l": "pane::SplitAndMoveRight",
            "ctrl-alt-k": "pane::SplitAndMoveUp",
            "ctrl-alt-j": "pane::SplitAndMoveDown"
        },
    },
    {
        // Move item to existing pane
        "bindings": {
            "alt-shift-h": ["workspace::MoveItemToPaneInDirection", { "direction": "left" }],
            "alt-shift-j": ["workspace::MoveItemToPaneInDirection", { "direction": "down" }],
            "alt-shift-k": ["workspace::MoveItemToPaneInDirection", { "direction": "up" }],
            "alt-shift-l": ["workspace::MoveItemToPaneInDirection", { "direction": "right" }]
        }
    },

    // File Operations
    {
        "bindings": {
            "ctrl-alt-p": "projects::OpenRecent",
            "alt-d": "pane::CloseActiveItem",
            "shift-alt-d": "pane::CloseAllItems",
            "alt-s": "workspace::Save",
            "shift-alt-s": "workspace::SaveWithoutFormat",
            "alt-n": "workspace::NewFile",
            "ctrl-alt-f": "editor::Format"
        }
    },

    // Editing
    {
        "bindings": {
            "alt-/": "editor::ToggleComments",
            "alt-w": "editor::ToggleSoftWrap"
        }
    },

    // Git (Editor context)
    {
        "context": "Editor",
        "bindings": {
            "alt-g": "editor::ExpandAllDiffHunks",
            "] g": "editor::GoToHunk",
            "[ g": "editor::GoToPreviousHunk"
        }
    },

    // UI / Layout
    {
        "bindings": {
            "alt-shift-`": "workspace::ToggleRightDock",
            "alt-z": "workspace::ToggleZoom",
            "alt-=": "workspace::IncreaseActiveDockSize",
            "alt--": "workspace::DecreaseActiveDockSize",
            "ctrl-alt-r": "workspace::ReloadActiveItem"
        }
    },
    {
        "context": "Workspace",
        "bindings": {
            "alt-`": "project_panel::ToggleFocus"
        }
    },
    {
        "context": "ProjectPanel",
        "bindings": {
            "alt-`": "git_panel::ToggleFocus"
        }
    },
    {
        "context": "GitPanel",
        "bindings": {
            "alt-`": "workspace::ToggleLeftDock"
        }
    },

    // Font Size
    {
        "bindings": {
            "ctrl-alt-=": "zed::IncreaseBufferFontSize",
            "ctrl-alt--": "zed::DecreaseBufferFontSize",
            "ctrl-0": "zed::ResetBufferFontSize"
        }
    },

    // Terminal
    {
        "bindings": {
            "ctrl-shift-`": "workspace::NewTerminal"
        }
    },

    // Settings
    {
        "context": "!KeymapEditor",
        "bindings": {
            "ctrl-shift-,": "zed::OpenKeymap"
        }
    },
    {
        "context": "KeymapEditor",
        "bindings": {
            "ctrl-shift-,": "zed::OpenKeymapFile"
        }
    },

    // Project Panel context
    {
        "context": "ProjectPanel && not_editing",
        "bindings": {
            "insert": "project_panel::NewFile",
            "shift-insert": "project_panel::NewDirectory",
            "c": "project_panel::CollapseSelectedEntry",
            "shift-o": "project_panel::ExpandSelectedEntry",
            "e": "project_panel::RevealInFileManager"
        }
    },
    {
        "context": "(VimControl && !menu) || (!Editor && !Terminal)",
        "bindings": {
            "ctrl-alt-shift-l": "workspace::MovePaneRight"
        }
    },
    {
        "context": "(VimControl && !menu) || (!Editor && !Terminal)",
        "unbind": {
            "ctrl-w shift-l": "workspace::MovePaneRight"
        }
    },
    {
        "context": "(VimControl && !menu) || (!Editor && !Terminal)",
        "bindings": {
            "ctrl-alt-shift-h": "workspace::MovePaneLeft"
        }
    },
    {
        "context": "(VimControl && !menu) || (!Editor && !Terminal)",
        "unbind": {
            "ctrl-w shift-h": "workspace::MovePaneLeft"
        }
    },
    {
        "context": "vim_mode == insert",
        "bindings": {
            "ctrl-v": "editor::Paste"
        }
    },
    {
        "context": "vim_mode == insert",
        "unbind": {
            "ctrl-shift-v": "editor::Paste"
        }
    },
    {
        "context": "Workspace",
        "unbind": {
            "ctrl-shift-m": "diagnostics::Deploy"
        }
    },
    {
        "context": "ProjectPanel",
        "bindings": {
            "`": "project_panel::ToggleHideGitIgnore"
        }
    },
    {
        "bindings": {
            "ctrl-alt-shift-,": "zed::OpenKeymapFile"
        }
    },
    {
        "context": "KeymapEditor",
        "unbind": {
            "ctrl-e": "zed::OpenKeymapFile"
        }
    },
    {
        "context": "ChangesList",
        "bindings": {
            "`": "git_panel::ActivateHistoryTab"
        }
    },
    {
        "context": "GitPanel",
        "unbind": {
            "ctrl-2": "git_panel::ActivateHistoryTab"
        }
    },
    {
        "context": "HistoryList",
        "bindings": {
            "`": "git_panel::ActivateChangesTab"
        }
    },
    {
        "context": "GitPanel",
        "unbind": {
            "ctrl-1": "git_panel::ActivateChangesTab"
        }
    }
]
