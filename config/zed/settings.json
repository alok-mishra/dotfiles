// https://zed.dev/docs/configuring-zed (`zed: open default settings`)

{
    ////// GENERAL //////
    "wsl_connections": [
        {
            "distro_name": "Arch",
            "user": null,
            "projects": []
        }
    ],
    "format_on_save": "on",
    "diff_view_style": "split",
    "cli_default_open_behavior": "existing_window",
    "restore_on_startup": "empty_tab",
    "terminal": {
        "shell": {
            "with_arguments": {
                "program": "zsh",
                "args": ["--login", "-i"]
            }
        }
    },
    "auto_update": false,
    "telemetry": {
        "diagnostics": false,
        "metrics": false
    },

    // "proxy": "http://localhost:6060",

    ////// APPEARANCE //////
    "theme": "Gruvbox Dark Hard",
    "icon_theme": "Zed (Default)",

    "ui_font_size": 14,
    "buffer_font_size": 12,
    "buffer_font_family": "CaskaydiaCove Nerd Font",

    ////// EDITOR //////
    "base_keymap": "Atom",
    "tab_size": 4,
    "preferred_line_length": 120,
    "file_types": {
        "Shell Script": ["*.aliases"]
    },
    "vim_mode": true,
    "vim": {
        "use_smartcase_find": true,
        "use_system_clipboard": "on_yank"
    },
    "prettier": {
        "allowed": true,
        "singleQuote": true,
        "trailingComma": "none"
    },

    ////// Search //////
    "use_smartcase_search": true,
    "search": {
        "include_ignored": true,
        "center_on_match": true
    },

    ////// Layout //////
    "tabs": {
        "file_icons": true,
        "git_status": true
    },
    "project_panel": {
        "dock": "left"
    },
    "git_panel": {
        "group_by": "staging",
        "dock": "left",
        "tree_view": true
    },
    "outline_panel": {
        "dock": "left"
    },
    "collaboration_panel": {
        "button": false
    },
    "session": {
        "trust_all_worktrees": true
    },

    ////// AGENTS //////
    "agent": {
        "default_model": {
            "provider": "copilot_chat",
            "model": "claude-sonnet-5",
            "enable_thinking": true,
            "effort": "medium"
        },
        "show_turn_stats": true,
        "dock": "right",
        "favorite_models": [],
        "model_parameters": [],
        "terminal_init_command": "copilot",
        "tool_permissions": {
            "tools": {
                "fetch": {
                    "default": "allow"
                },
                "terminal": {
                    "default": "confirm",
                    "always_allow": [
                        {
                            "pattern": "^(awk|cat|date|echo|grep|head|ls|pdftotext|pwd|sed|sleep|sort|tail|test|uname|wc)\\b"
                        },
                        {
                            "pattern": "^docker\\s+((compose|container|image|network|volume)\\s+)?(diff|history|images|info|inspect|list|logs|ls|port|ps|stats|top|version)(\\s|$)"
                        },
                        {
                            "pattern": "^git(\\s+--no-(pager|optional-locks))*\\s+(blame|diff|log|show|stash\\s+list|status)\\b"
                        },
                        {
                            "pattern": "^uname\\b"
                        },
                        {
                            "pattern": "^ver\\b"
                        },
                        {
                            "pattern": "^cut\\b"
                        },
                        {
                            "pattern": "^python3\\b"
                        },
                        {
                            "pattern": "^docker\\s+exec(\\s|$)"
                        },
                        {
                            "pattern": "^uv\\s+run(\\s|$)"
                        }
                    ],
                    "always_confirm": [
                        { "pattern": "\\b(chmod|chown|kill|mv|pkill|sudo)\\b" },
                        { "pattern": ">>?\\s*[^&\\s]" },
                        { "pattern": "^awk\\s+.*system\\s*\\(" },
                        { "pattern": "^docker\\s+(.*\\s)?(build|down|exec|kill|prune|rm|rmi|run|stop|up)(\\s|$)" },
                        { "pattern": "^git\\s+(add|checkout|commit|merge|rebase|reset|tag)\\b" }
                    ],
                    "always_deny": [{ "pattern": "\\bgit\\s+(.*\\s)?(reset\\s+.*--hard|clean\\s+.*(-\\w*f|--force))" }, { "pattern": "^git\\s+(.*\\s)?push(\\s|$)" }]
                }
            }
        }
    },
    "agent_servers": {
        "OpenCode": {
            "type": "custom",
            "command": "opencode",
            "args": ["acp"]
        }
    },
    "edit_predictions": {
        "provider": "copilot"
    },

    ////// LSP //////
    "lsp": {
        "basedpyright": {
            "settings": {
                "python": {
                    "pythonPath": ".venv/bin/python"
                }
            }
        }
    },
    "languages": {
        "JSON": {},
        "JSONC": {
            "preferred_line_length": 200
        },
        "Markdown": {
            "language_servers": ["!markdownlint", "..."]
        }
    }
}
