// https://zed.dev/docs/configuring-zed (`zed: open default settings`)

{
    ////// GENERAL //////
    "format_on_save": "on",
    "diff_view_style": "split",
    "cli_default_open_behavior": "existing_window",
    "restore_on_startup": "empty_tab",
    "terminal": {
        "shell": {
            "with_arguments": {
                "program": "zsh",
                "args": ["--login", "-i"]
            }
        }
    },
    "auto_update": false,
    "telemetry": {
        "diagnostics": false,
        "metrics": false
    },

    // "proxy": "http://localhost:6060",

    ////// APPEARANCE //////
    "theme": "Gruvbox Dark Hard",
    "icon_theme": "Zed (Default)",
    "buffer_font_family": "CaskaydiaCove Nerd Font",
    "buffer_font_size": 12,
    "ui_font_size": 15,

    ////// EDITOR //////
    "base_keymap": "Atom",
    "tab_size": 4,
    "file_types": {
        "Shell Script": ["*.aliases"]
    },
    "vim_mode": true,
    "vim": {
        "use_smartcase_find": true,
        "use_system_clipboard": "on_yank"
    },
    "prettier": {
        "allowed": true,
        "singleQuote": true,
        "trailingComma": "es5"
    },

    ////// Search //////
    "use_smartcase_search": true,
    "search": {
        "include_ignored": true,
        "center_on_match": true
    },

    ////// Layout //////
    "tabs": {
        "file_icons": true,
        "git_status": true
    },
    "project_panel": {
        "dock": "left"
    },
    "git_panel": {
        "dock": "left",
        "tree_view": true
    },
    "outline_panel": {
        "dock": "left"
    },
    "session": {
        "trust_all_worktrees": true
    },

    ////// AGENTS //////
    "agent_servers": {
        "github-copilot-cli": {
            "type": "registry"
        },
        "OpenCode": {
            "type": "custom",
            "command": "opencode",
            "args": ["acp"]
        },
        "github-copilot": {
            "type": "registry",
        },
    },

}
