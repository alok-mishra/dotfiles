[user]
    name = Alok Mishra
    email = alok@alokmishra.com
[color]
    ui = true
    diff = auto
    status = auto
    branch = auto
    interactive = auto
    ui = true
    pager = true

[diff]
    prompt = true
    tool = bcompare
[difftool "bcompare"]
    cmd = bcompare \"$LOCAL\" \"$REMOTE\"
[difftool "beyondcompare"]
    cmd = bcomp.exe \"$LOCAL\" \"$REMOTE\"
[difftool "wsl_beyondcompare"]
    cmd = bcomp.exe "$(wslpath -aw $LOCAL)" "$(wslpath -aw $REMOTE)"
[difftool "meld"]
    cmd = meld "$LOCAL" "$REMOTE"
[difftool "vscode"]
    cmd = code-insiders --wait --diff $LOCAL $REMOTE

[merge]
    tool = wsl_zed
[mergetool]
    keepBackup = false
[mergetool "beyondcompare"]
    cmd = bc
[mergetool "wsl_beyondcompare"]
    cmd = bc "$(wslpath -aw $LOCAL)" "$(wslpath -aw $REMOTE)" "$(wslpath -aw $BASE)" "$(wslpath -aw $MERGED)"
[mergetool "vscode"]
    cmd = code-insiders --wait $MERGED
[mergetool "wsl_zed"]
    cmd = zed.exe --wait "$(wslpath -aw $MERGED)"


[push]
    default = simple
[pull]
    ff = only

[core]
    editor = vim
    autocrlf = input
    symlinks = true
    excludesfile = ~/.gitignore_global
    hooksPath = /home/alok/.git-hooks

[init]
    defaultBranch = master
[safe]
    directory = *
[protocol "file"]
    allow = always
